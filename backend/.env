# Environment
NODE_ENV=development  # Change to "production" for production mode
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/auralist-store  # Use a cloud database service (e.g., MongoDB Atlas) for production
# Example: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=Y0urSecretKey  # Replace with a stronger secret key in production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# OAuth Credentials (Replace with actual credentials in production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret


# Email Configuration (Use a more secure email service for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password  # Use environment variables or a secret manager for security
EMAIL_FROM=noreply@auralist.com

# URLs
FRONTEND_URL=http://localhost:3000  # Change to the production frontend URL when deployed
SOCKET_CORS_ORIGIN=http://localhost:3000  # Should match the frontend URL

# --- PRODUCTION CONFIGURATION (Use .env.production or environment variables) ---
# NODE_ENV=production
# MONGODB_URI=your-production-mongodb-uri
# JWT_SECRET=your-secure-jwt-secret
# FRONTEND_URL=https://your-production-domain.com
# SOCKET_CORS_ORIGIN=https://your-production-domain.com
