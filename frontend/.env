# API Configuration
REACT_APP_API_URL=http://localhost:5000/api  # Change to the production API URL when deployed

# Authentication Settings 
REACT_APP_JWT_EXPIRY=7d  # JWT token expiration time

# Feature Flags
REACT_APP_ENABLE_SOCIAL_LOGIN=true  # Enable social login (Google, Facebook, etc.)
REACT_APP_ENABLE_GUEST_CHECKOUT=true  # Allow guest checkout without an account

# Analytics
REACT_APP_GA_TRACKING_ID=your_ga_tracking_id  # Google Analytics tracking ID

# Other Settings
REACT_APP_ITEMS_PER_PAGE=12  # Number of items displayed per page
REACT_APP_IMAGE_BASE_URL=http://localhost:5000/uploads  # Base URL for uploaded images

# --- PRODUCTION CONFIGURATION (Use .env.production or environment variables) ---
# REACT_APP_API_URL=https://your-production-api.com/api
# REACT_APP_IMAGE_BASE_URL=https://your-production-api.com/uploads
